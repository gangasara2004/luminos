# ── LUMINOS BACKEND — copy this to .env for local dev ─────────────────────────
# On Railway: paste these into Variables tab (Raw Editor), do NOT commit .env

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Admin password (plain text — hashed at startup)
# For production, use ADMIN_PASSWORD_HASH instead (see below)
ADMIN_PASSWORD=admin123

# JWT signing secret — ALWAYS change this, use a long random string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-string

# Your Cloudflare Pages URL (no trailing slash)
# Multiple URLs: ALLOWED_ORIGINS=https://app.pages.dev,https://yourdomain.com
ALLOWED_ORIGINS=https://your-app.pages.dev

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Pre-hashed password (more secure than plain ADMIN_PASSWORD)
# Generate: node -e "const b=require('bcryptjs'); console.log(b.hashSync('yourpass',12))"
# ADMIN_PASSWORD_HASH=$2b$12$...

# WebSocket room name (change if running multiple shows simultaneously)
SESSION_ID=luminos-live

# Server port (Railway sets this automatically — don't set manually on Railway)
# PORT=3001

# Node environment
NODE_ENV=production
